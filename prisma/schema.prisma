// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  hashedPassword String?
  role          Role      @default(JOB_SEEKER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  jobSeekerProfile JobSeekerProfile? @relation("JobSeeker")
  employerProfile  EmployerProfile?  @relation("Employer")
  jobs             Job[]             @relation("EmployerJobs")
  applications     JobApplication[]  @relation("JobSeekerApplications")
  savedJobs        SavedJob[]
  accounts         Account[]
  sessions         Session[]

  @@index([email])
  @@map("users")
}

model JobSeekerProfile {
  id           String                 @id @default(cuid())
  userId       String                 @unique
  user         User                   @relation("JobSeeker", fields: [userId], references: [id], onDelete: Cascade)
  resumeUrl    String?
  phone        String?
  headline     String?
  bio          String?
  location     String?
  websiteUrl   String?
  linkedinUrl  String?
  isComplete   Boolean                @default(false)
  skills       JobSeekerSkill[]
  experiences  JobSeekerExperience[]
  educations   JobSeekerEducation[]

  @@index([userId])
  @@map("job_seeker_profiles")
}

model EmployerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation("Employer", fields: [userId], references: [id], onDelete: Cascade)
  companyName    String
  companyLogo    String?
  companyWebsite String?
  companySize    String?
  industry       String?
  location       String?
  isVerified     Boolean  @default(false)

  @@index([userId])
  @@map("employer_profiles")
}

model Job {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  requirements String
  responsibilities String?
  salaryMin   Float?
  salaryMax   Float?
  salaryType  String?  // "Fixed", "Range", "Negotiable"
  location    String
  jobType     JobType  // "Full-time", "Part-time", "Remote", "Contract"
  experience  String   // "Entry", "Mid", "Senior"
  categoryId  String
  category    JobCategory @relation(fields: [categoryId], references: [id])
  employerId  String
  employer    User     @relation("EmployerJobs", fields: [employerId], references: [id])
  status      JobStatus @default(ACTIVE)
  applicationDeadline DateTime?
  applications JobApplication[]
  savedBy     SavedJob[]
  paymentStatus PaymentStatus @default(UNPAID)
  stripeSessionId String?
  paymentIntentId String?
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  published   Boolean  @default(true)

  @@index([slug])
  @@index([employerId])
  @@index([categoryId])
  @@index([published])
  @@index([status, published])
  @@index([jobType, location])
  @@index([createdAt])
  @@map("jobs")
}

model JobApplication {
  id           String   @id @default(cuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seekerId     String
  seeker       User     @relation("JobSeekerApplications", fields: [seekerId], references: [id])
  resumeUrl    String?
  coverLetter  String?
  status       ApplicationStatus @default(PENDING)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([jobId, seekerId])
  @@index([jobId])
  @@index([seekerId])
  @@index([status])
  @@map("job_applications")
}

model JobCategory {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  jobs  Job[]

  @@map("job_categories")
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@map("saved_jobs")
}

model JobSeekerSkill {
  id         String           @id @default(cuid())
  profileId  String
  profile    JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime         @default(now())

  @@index([profileId])
  @@map("job_seeker_skills")
}

model JobSeekerExperience {
  id           String           @id @default(cuid())
  profileId    String
  profile      JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title        String
  company      String
  location     String?
  employmentType String?
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean          @default(false)
  description  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([profileId])
  @@map("job_seeker_experiences")
}

model JobSeekerEducation {
  id           String           @id @default(cuid())
  profileId    String
  profile      JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  institution  String
  degree       String
  fieldOfStudy String?
  startDate    DateTime?
  endDate      DateTime?
  isCurrent    Boolean          @default(false)
  description  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([profileId])
  @@map("job_seeker_educations")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum Role {
  JOB_SEEKER
  EMPLOYER
  ADMIN
}

enum JobType {
  FULL_TIME
  PART_TIME
  REMOTE
  CONTRACT
  INTERNSHIP
}

enum JobStatus {
  PENDING
  ACTIVE
  EXPIRED
  DRAFT
  REJECTED
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  SHORTLISTED
  INTERVIEW
  REJECTED
  HIRED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
}
